{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odi.dev/schemas/cognition-stack/L12-self-critique.schema.json",
  "title": "L12 Self-Critique",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "draft_ref", "findings", "pass"],
  "properties": {
    "id": { "type": "string" },
    "draft_ref": { "type": "string" },
    "attention_path_check": {
      "type": "object",
      "description": "Output Visual Cognition Engine dibandingkan terhadap L4",
      "properties": {
        "attention_path": { "type": "array", "items": { "type": "string" } },
        "matches_message_hierarchy": { "type": "boolean" },
        "mismatches": { "type": "array", "items": { "type": "string" } }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer_ref", "issue", "severity"],
        "properties": {
          "layer_ref": { "type": "string", "pattern": "^L(0[0-9]|1[0-4])$" },
          "issue": { "type": "string" },
          "severity": { "type": "string", "enum": ["minor", "major", "blocking"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "pass": { "type": "boolean", "description": "true hanya jika tidak ada finding 'blocking'" }
  }
}
