{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odi.dev/schemas/knowledge-graph/domain.schema.json",
  "title": "Domain Node",
  "description": "Konteks aplikasi output, mis. Poster, Company Profile, Dashboard UI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description"],
  "properties": {
    "id": { "type": "string", "pattern": "^domain:[a-z0-9-]+$" },
    "name": { "type": "string" },
    "description": { "type": "string" }
  }
}
